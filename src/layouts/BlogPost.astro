---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TagLink from "../components/TagLink.astro";
import BlogImage from "../components/BlogImage.astro";
import { SITE_URL } from "../consts";
import { resolveBlogImage } from "../utils/blogImages";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

// ブログ記事のURL取得
const postUrl = new URL(Astro.url.pathname, SITE_URL);

// OGP・構造化データ用の画像パス。
// heroImage が src/assets/blog-assets/ にある場合は public/ に存在しないため、
// build 時に出力される元画像（/_astro/...）の URL を使う
const heroAsset = await resolveBlogImage(heroImage);
const shareImage = heroAsset ? heroAsset.src : heroImage;

// 画像のフルURLを生成
const imageUrl = shareImage
  ? new URL(shareImage, SITE_URL).toString()
  : new URL('/tcuA.webp', SITE_URL).toString();

// BlogPosting Schema用のデータ準備
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": imageUrl,
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "都市大アニメーション",
    "url": SITE_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": "都市大アニメーション",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/logo.webp', SITE_URL).toString()
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl.toString()
  },
  "keywords": tags ? tags.join(", ") : "",
  "inLanguage": "ja-JP"
};

---

<html lang="ja" class="dark">
  <head>
    <BaseHead title={title} description={description} image={shareImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- BlogPosting Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-61T79P21HB"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-61T79P21HB');
    </script>
  </head>
  <body class="w-full mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300">
    <Header />
    <main id="blog" class="mt-36">
      <article class="px-4 max-w-3xl mx-auto">
        <div class="flex justify-between mb-6">
          <FormattedDate date={pubDate} />
          <p class="text-gray-500 dark:text-neutral-400 text-xs font-medium tracking-wide">
            5 min read
          </p>
        </div>
        <h1 class="blog-tile text-5xl mb-8">
          {title}
        </h1>
        <div>
          {/* article は max-w-3xl（768px）+ px-4 なので本文幅は最大 736px。
              以前は width="1020" 属性と max-width: 100% で常に本文幅いっぱいに
              表示されていたため、元画像が小さい記事でも同じ見た目になるよう w-full を付ける */}
          {
            heroImage && (
            <BlogImage
              src={heroImage}
              alt="東京都市大学 アニメーション"
              class="hero-img w-full"
              widths={[320, 480, 640, 736, 960, 1280, 1472]}
              sizes="(min-width: 768px) 736px, calc(100vw - 32px)"
            />
            )
          }
        </div>
        <div class="mt-10">
          <slot />
        </div>

        <!-- 更新日表示（存在する場合） -->
        {updatedDate && pubDate.getTime() !== updatedDate.getTime() && (
          <p class="text-sm text-gray-500 dark:text-neutral-400 mt-8 border-t pt-4">
            最終更新: <FormattedDate date={updatedDate} />
          </p>
        )}

        <div>
          {
            tags && (
                <ul class="tag-ul flex gap-2">
                  {tags.map((tag: string) => (
                    <li>
                      <TagLink tag={tag} />
                    </li>
                  ))}
                </ul>
            )
          }
        </div>
      </article>
    </main>
    <Footer />
  </body>

  <style is:inline>
    /* Base Styles */
    img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 20px 0;
    }

    /* Headings */
    h1, h2, h3, h4, h5, h6 {
        color: var(--grey-900);
        margin-top: 24px;
        margin-bottom: 16px;
        font-weight: bold;
    }

    h1 { font-size: 32px; }
    h2 { font-size: 28px; }
    h3 { font-size: 24px; }
    h4 { font-size: 20px; }
    h5 { font-size: 18px; }
    h6 { font-size: 16px; }

    /* Paragraphs */
    p {
        margin-top: 0;
        margin-bottom: 16px;
    }

    a {
        color: var(--color-primary);
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }

    /* Blockquotes */
    blockquote {
        border-left: 4px solid #ccc;
        padding: 10px 20px;
        margin: 20px 0;
        color: #666;
        background-color: #f9f9f9;
        @apply dark:bg-neutral-700 text-white border-l-4 border-neutral-500; 
    }

    /* Code Blocks and Inline Code */

    pre {
        padding: 10px;
        overflow-x: auto;
        margin-top: 0;
        margin-bottom: 16px;
    }

    code {
        padding: 2px 4px;
        font-family: 'Courier New', monospace;
        font-size: 90%;
    }

    /* Tables */
    table {
        width: 100%;
        margin-bottom: 20px;
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
        border: 1px solid #ddd;
    }

    th {
        background-color: #f4f4f4;
        @apply dark:bg-neutral-700;
    }

    /* Lists */
    .footnotes ul, ol {
        margin-top: 0;
        margin-bottom: 16px;
        padding-left: 20px;
        list-style: outside;
    }

    /* Special HTML Tags */
    abbr {
        border-bottom: 1px dotted #666;
        cursor: help;
    }

    kbd {
        padding: 2px 4px;
        font-size: 90%;
        color: #fff;
        background-color: #333;
        border-radius: 3px;
    }

    mark {
        background-color: yellow;
        color: black;
    }

    sup, sub {
        font-size: 75%;
        line-height: 0;
        position: relative;
        vertical-align: baseline;
    }

    sup { top: -0.5em; }
    sub { bottom: -0.25em; }

    ul {
        list-style-type: disc;
        padding-left: 1rem;
        margin: 1rem;
    }

    .tag-ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

</style>
</html>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.blog-tile', {
    scrollTrigger: {
      trigger: '.blog-tile',
      start: 'top 80%',
    },
    opacity: 0,
    y: 50,
    duration: 1,
    ease: 'power2.out',
  });

  gsap.from('.hero-img', {
    scrollTrigger: {
      trigger: '.hero-img',
      start: 'top 80%',
    },
    opacity: 0,
    y: 50,
    duration: 1,
    ease: 'power2.out',
    delay: 0.5,
  });
</script>