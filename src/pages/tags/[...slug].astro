---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import TagLink from '../../components/TagLink.astro';
import BlogImage from '../../components/BlogImage.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
    const tags = posts.flatMap((post: CollectionEntry<'blog'>) => post.data.tags || []).filter((tag): tag is string => tag !== undefined);
    return tags.map((tag: string) => ({
        params: { slug: tag },
        props: { tag, posts: posts.filter((post: CollectionEntry<'blog'>) => post.data?.tags?.includes(tag)) },
    }));
}
const {tag, posts}: { tag: string; posts: CollectionEntry<'blog'>[] } = Astro.props;
type Post = CollectionEntry<'blog'>;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={tag as string} description={"Posts tagged with " + tag as string + "."} />
  </head>
  <body class="w-full flex flex-col mx-auto max-w-screen-md min-h-dvh justify-between dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300" >
    <Header />
    <main class="flex flex-col justify-center lg:mt-28 mt-20 px-4">
        <h2 class="w-full font-bold text-black dark:text-white mb-8">🗃️ Posts tagged with <span>
            {tag}</span></h2>
        <ul>
            {posts.map((post: Post) => (
                <div class="flex gap-2 justify-between border-b pb-4">
              <div class="flex flex-col gap-4">
                <FormattedDate date={post.data.pubDate} />
                <a class="font-bold text-lg" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
                <div class="flex gap-2">
                  {post.data.tags?.map((i: string) => {
                    return <TagLink tag={i} />;
                  })}
                </div>
              </div>
              <a href={`/blog/${post.id}`}>
                {/* /blog/ 一覧と同じ 160x96px の object-cover 枠（必要な横幅は約 171px） */}
                <BlogImage
                  src={post.data.heroImage || '/tcuA.webp'}
                  alt={`${post.data.title} - 都市大アニメーションのブログ記事サムネイル`}
                  class="w-40 h-24 object-cover border border-gray-200"
                  widths={[180, 360]}
                  sizes="180px"
                />
              </a>
            </div>
                ))}
        </ul>
    </main>
    <Footer />
  </body>
</html>
